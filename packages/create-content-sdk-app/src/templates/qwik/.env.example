# =============================================================================
# Sitecore Content SDK — Qwik sample connection checklist
# Copy to `.env` and fill values. Never commit `.env`.
# =============================================================================
#
# From Sitecore Deploy / XM Cloud / SitecoreAI → your environment:
#   [ ] Edge Context ID     → SITECORE_EDGE_CONTEXT_ID + PUBLIC_SITECORE_EDGE_CONTEXT_ID
#   [ ] Site name           → PUBLIC_DEFAULT_SITE_NAME  (Sites list, e.g. website)
#   [ ] Default language    → PUBLIC_DEFAULT_LANGUAGE   (usually en)
#   [ ] Editing secret      → SITECORE_EDITING_SECRET   (you choose; match rendering host)
#
# Content prerequisites (in Sitecore):
#   [ ] Headless site with main placeholder `headless-main`
#   [ ] At least one published page at `/`
#   [ ] A `ContentBlock` rendering on that page (or update src/.sitecore/component-map.ts)
#
# Editing (Pages) — after delivery works:
#   [ ] Tunnel localhost (ngrok/cloudflare) and set as rendering host URL
#   [ ] Same SITECORE_EDITING_SECRET on the rendering host
#   [ ] Optional CORS: JSS_ALLOWED_ORIGINS for Sitecore Pages origins
#
# =============================================================================

# Sitecore editor endpoint secret (`/api/editing/render` and `/api/editing/config`)
SITECORE_EDITING_SECRET=

# Optional: extra CORS origins for the Pages iframe (comma-separated)
# JSS_ALLOWED_ORIGINS=https://xmc-*.sitecorecloud.io

# Default site name
PUBLIC_DEFAULT_SITE_NAME=

# Default language
PUBLIC_DEFAULT_LANGUAGE=en

# Unified Sitecore Edge Context Id (server)
SITECORE_EDGE_CONTEXT_ID=

# Sitecore Edge Context Id (client / Vite PUBLIC_)
PUBLIC_SITECORE_EDGE_CONTEXT_ID=

# Optional: custom Sitecore Edge Platform hostname
PUBLIC_SITECORE_EDGE_PLATFORM_HOSTNAME=

# Optional local API (preview / CM)
PUBLIC_SITECORE_API_KEY=
PUBLIC_SITECORE_API_HOST=

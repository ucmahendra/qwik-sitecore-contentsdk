{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2017",
    "module": "commonjs",
    "jsx": "react-jsx",
    "jsxImportSource": "@builder.io/qwik",
    "outDir": "dist/cjs",
    "types": ["node", "mocha"],
    "typeRoots": ["node_modules/@types"],
    "declarationDir": "./types",
    "skipLibCheck": true
  },
  "exclude": [
    "node_modules",
    "types",
    "dist",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
